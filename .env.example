# Copy this file to ".env" (same folder) and fill in your real values.
# .env is already blocked from direct web access (see root .htaccess)
# and should never be committed to version control.

DB_HOST=localhost
DB_NAME=epic_paper
DB_USER=epic_user
DB_PASS=change_this_password

# Note: the WhatsApp number and contact details (phone, email, address)
# are NOT set here they live in the database and are edited from the
# admin panel under "Contact & Settings" once the site is running.
